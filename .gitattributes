# Normalize line endings: auto-detect text, check out/in with LF.
* text=auto eol=lf

# Explicit text files (documentation and config)
*.md        text
*.txt       text
*.py        text diff=python
*.toml      text
*.cfg       text
*.ini       text
*.yml       text
*.yaml      text
*.json      text
*.cff       text
LICENSE     text
CHANGELOG.md text

# Windows-specific scripts should keep CRLF
*.bat       text eol=crlf
*.cmd       text eol=crlf

# Shell scripts must stay LF
*.sh        text eol=lf

# Binary files (never normalize or diff)
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.pdf       binary
*.zst       binary
*.zip       binary
*.gz        binary
*.db        binary
*.sqlite    binary
*.parquet   binary

# ---------------------------------------------------------------------------
# Keep source archives (git archive / GitHub release tarballs) clean by
# excluding dev-only paths.
# ---------------------------------------------------------------------------
tests/          export-ignore
docs/           export-ignore
.github/        export-ignore
.gitignore      export-ignore
.gitattributes  export-ignore
.pre-commit-config.yaml export-ignore
