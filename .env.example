# Rewind — example environment file.
# Copy to `.env` (which is git-ignored) and fill in real values for local dev.
# Rewind records agent runs; API keys are only needed to CAPTURE a live run —
# replay is offline and needs no keys.

# --- LLM providers (only what you actually record against) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Determinism (set before the interpreter starts; the recorder relaunches with it) ---
# Pin hash-seed so set/dict iteration order is reproducible on replay.
PYTHONHASHSEED=0

# --- Rewind config (optional; defaults are fine) ---
# Where recordings are stored (git-ignored by default).
# REWIND_HOME=.rewind
# Capture message content? Recordings may contain PII/secrets — redaction runs
# before storage regardless. Set to 0 for structure-only (not replayable).
# REWIND_CAPTURE_CONTENT=1

# --- Local LLM (optional; for offline judge / cluster summaries, later phases) ---
# OLLAMA_HOST=http://localhost:11434
